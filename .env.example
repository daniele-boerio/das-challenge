# Copia in .env solo in locale. In produzione queste vanno nelle variabili di Coolify.
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-opus-4-8
# Mail dei codici di accesso (es. Gmail con una password per le app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Facoltativo: solo queste mail possono entrare (separate da virgola)
ALLOWED_EMAILS=
# In locale su http: false
COOKIE_SECURE=false
